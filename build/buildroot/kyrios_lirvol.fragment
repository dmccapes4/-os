# kyrios fragment over raspberrypi5_defconfig — lirvol (Pi 5, 8 GB, NVMe).
# The port daemon is C (ladder D4 as corrected 2026-11-16); it will need
# jansson + libopenssl when the C port lands. Python 3 stays for now for
# the ledger tools and on-target test harnesses, and may leave the image
# once those are ported or proven bench-side only.
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON3_CODECSCJK=n
BR2_PACKAGE_PYTHON3_CURSES=n
BR2_PACKAGE_PYTHON3_DECIMAL=y
BR2_PACKAGE_PYTHON3_OSSAUDIODEV=n
BR2_PACKAGE_PYTHON3_READLINE=n
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_PYTHON3_ZLIB=y
# Arrival by SSH for the first image (key-only is configured in users/permissions, track P3).
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y
# Small honest tools for first-boot receipts.
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_LAST=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_E2FSCK=y
BR2_PACKAGE_E2FSPROGS_MKE2FS=y
